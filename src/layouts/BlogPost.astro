---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

// Extract category from title
function getCategory(title: string): string {
  const lowerTitle = title.toLowerCase();
  if (lowerTitle.includes('ai') || lowerTitle.includes('chatgpt') || lowerTitle.includes('claude')) return 'AI Tools';
  if (lowerTitle.includes('crm') || lowerTitle.includes('project management')) return 'Business';
  if (lowerTitle.includes('website') || lowerTitle.includes('builder')) return 'Web Tools';
  if (lowerTitle.includes('video') || lowerTitle.includes('conferencing')) return 'Communication';
  if (lowerTitle.includes('productivity') || lowerTitle.includes('remote')) return 'Productivity';
  if (lowerTitle.includes('vs')) return 'Comparison';
  return 'Software';
}

const category = getCategory(title);
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    
    {/* JSON-LD Schema Markup for SEO */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "datePublished": pubDate.toISOString(),
      "dateModified": (updatedDate || pubDate).toISOString(),
      "author": {
        "@type": "Person",
        "name": "Badal",
        "url": "https://munex.in/about"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Munex",
        "url": "https://munex.in",
        "logo": {
          "@type": "ImageObject",
          "url": "https://munex.in/favicon.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": Astro.url.href
      },
      "articleSection": category,
      "inLanguage": "en-US"
    })} />
  </head>

  <body>
    <Header />
    
    <main>
      <article class="article">
        <header class="article-header">
          <div class="container-narrow">
            <span class="tag">{category}</span>
            <h1 class="article-title">{title}</h1>
            <div class="article-meta">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <span class="updated">
                  · Updated <FormattedDate date={updatedDate} />
                </span>
              )}
            </div>
          </div>
        </header>

        {heroImage && (
          <div class="hero-image">
            <div class="hero-image-container">
              <Image 
                width={1200} 
                height={600} 
                src={heroImage} 
                alt={title} 
                class="hero-img"
              />
            </div>
          </div>
        )}

        <div class="article-content">
          <div class="container-narrow prose">
            <slot />
          </div>
        </div>

        <footer class="article-footer">
          <div class="container-narrow">
            <hr class="footer-divider" />
            <div class="footer-cta">
              <p>Found this review helpful?</p>
              <a href="/blog" class="back-link">← Browse more reviews</a>
            </div>
          </div>
        </footer>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  .article {
    padding-bottom: var(--space-2xl);
  }

  .article-header {
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .container-narrow {
    max-width: var(--container-narrow);
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--primary);
    background-color: rgba(13, 148, 136, 0.1);
    padding: 0.25em 0.75em;
    border-radius: 4px;
    margin-bottom: var(--space-md);
  }

  .article-title {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
    margin-bottom: var(--space-lg);
    letter-spacing: -0.02em;
  }

  .article-meta {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .updated {
    font-style: italic;
  }

  .hero-image {
    margin-bottom: var(--space-2xl);
  }

  .hero-image-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .hero-img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .article-content {
    margin-bottom: var(--space-2xl);
  }

  .article-footer {
    margin-top: var(--space-3xl);
  }

  .footer-divider {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--border), transparent);
    margin-bottom: var(--space-xl);
  }

  .footer-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-cta p {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
  }

  .back-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--primary);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--primary-dark);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .article-header {
      padding: var(--space-2xl) 0 var(--space-lg);
    }

    .container-narrow,
    .hero-image-container {
      padding: 0 var(--space-md);
    }

    .footer-cta {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
    }
  }
</style>
