---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = allPosts[0];
const recentPosts = allPosts.slice(1, 7);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    
    {/* WebSite Schema for SEO */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Munex",
      "description": SITE_DESCRIPTION,
      "url": "https://munex.in",
      "author": {
        "@type": "Person",
        "name": "Badal",
        "url": "https://munex.in/about"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Munex",
        "url": "https://munex.in"
      }
    })} />
  </head>
  <body>
    <Header />
    
    <main>
      <!-- Hero Section -->
      <section class="hero">
        <div class="hero-container">
          <p class="hero-intro">I review software tools honestly. No fluff.</p>
          <h1 class="hero-title">Find the right software for your work.</h1>
          <p class="hero-description">
            Real reviews from actual usage — not sponsored rankings or affiliate-driven recommendations.
          </p>
        </div>
      </section>

      <!-- Stats Section -->
      <section class="stats">
        <div class="stats-container">
          <div class="stat-item">
            <span class="stat-number">{allPosts.length}+</span>
            <span class="stat-label">In-depth reviews</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number">50+</span>
            <span class="stat-label">Tools compared</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number">100%</span>
            <span class="stat-label">Independent</span>
          </div>
        </div>
      </section>

      <hr class="divider container" />

      <!-- Latest Reviews Section -->
      <section class="reviews">
        <div class="reviews-container">
          <header class="section-header">
            <span>Latest Reviews</span>
          </header>

          {featuredPost && (
            <div class="featured-post">
              <PostCard post={featuredPost} featured={true} />
            </div>
          )}

          <div class="posts-grid">
            {recentPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>

          <div class="view-all">
            <a href="/blog" class="view-all-link">
              View all reviews →
            </a>
          </div>
        </div>
      </section>

      <!-- About Teaser -->
      <section class="about-teaser">
        <div class="about-container">
          <hr class="divider" />
          <header class="section-header">
            <span>About Munex</span>
          </header>
          <div class="about-content">
            <p>
              Munex is run by <strong>Badal</strong>, a software engineer who got tired of 
              reading reviews that felt more like ads than genuine assessments. Every tool 
              here is tested hands-on, compared fairly, and reviewed honestly.
            </p>
            <a href="/about" class="about-link">Learn more about our approach →</a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  /* Hero */
  .hero {
    padding: var(--space-4xl) 0 var(--space-2xl);
  }

  .hero-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .hero-intro {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--primary);
    margin-bottom: var(--space-md);
    letter-spacing: 0.02em;
  }

  .hero-title {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
    margin-bottom: var(--space-lg);
    letter-spacing: -0.02em;
    max-width: 700px;
  }

  .hero-description {
    font-size: 1.125rem;
    color: var(--text-muted);
    max-width: 550px;
    line-height: 1.7;
    margin: 0;
  }

  /* Stats */
  .stats {
    padding: var(--space-xl) 0;
  }

  .stats-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-xl);
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .stat-number {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background-color: var(--border);
  }

  /* Divider */
  .divider {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--border), transparent);
    margin: var(--space-2xl) auto;
  }

  .container {
    max-width: var(--container-max);
    padding: 0 var(--space-xl);
  }

  /* Reviews Section */
  .reviews {
    padding: var(--space-xl) 0;
  }

  .reviews-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .featured-post {
    margin-bottom: var(--space-xl);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .view-all {
    text-align: center;
    padding-top: var(--space-lg);
  }

  .view-all-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .view-all-link:hover {
    color: var(--primary-dark);
  }

  /* About Teaser */
  .about-teaser {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .about-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .about-content {
    max-width: 550px;
  }

  .about-content p {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .about-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--primary);
    text-decoration: none;
  }

  .about-link:hover {
    color: var(--primary-dark);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .hero {
      padding: var(--space-2xl) 0 var(--space-xl);
    }

    .hero-container,
    .stats-container,
    .reviews-container,
    .about-container {
      padding: 0 var(--space-md);
    }

    .stats-container {
      flex-wrap: wrap;
      gap: var(--space-lg);
    }

    .stat-divider {
      display: none;
    }

    .posts-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
