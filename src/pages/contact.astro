---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Contact — Munex" description="Get in touch with Badal at Munex. Questions, feedback, or tool suggestions welcome." />
  </head>
  <body>
    <Header />
    
    <main>
      <article class="contact-page">
        <header class="page-header">
          <div class="container-narrow">
            <span class="category-label">Contact</span>
            <h1 class="page-title">Get in Touch</h1>
            <p class="page-description">
              Have a question about a tool I reviewed? Want to suggest software for me to cover? 
              Or just want to say hello? I'd love to hear from you.
            </p>
          </div>
        </header>

        <hr class="section-divider" />

        <div class="container-narrow">
          <div class="email-card">
            <p class="email-label">Email me directly</p>
            <a href="mailto:support@munex.in" class="email-link">support@munex.in</a>
            <p class="email-note">I typically respond within 24-48 hours on business days.</p>
          </div>

          <div class="prose">
            <h2>What I Can Help With</h2>
            <ul>
              <li><strong>Tool Suggestions</strong> — Is there a SaaS tool or AI product you'd like me to review? Let me know.</li>
              <li><strong>Corrections</strong> — Found an error in my content? I appreciate you helping me stay accurate.</li>
              <li><strong>Collaborations</strong> — Interested in working together? I'm open to collaborations that benefit my readers.</li>
              <li><strong>General Questions</strong> — Anything else on your mind? Just ask.</li>
            </ul>

            <h2>Before You Reach Out</h2>
            <p>You might find what you're looking for in my existing content:</p>
            <ul>
              <li><a href="/about">About Munex</a> — Who I am and how I work</li>
              <li><a href="/blog">My Reviews</a> — Browse all my software reviews</li>
              <li><a href="/privacy">Privacy Policy</a> — How I handle your data</li>
            </ul>

            <div class="note-card">
              <p>I read every email personally. No bots, no templates—just a real human who cares about helping you find the right tools.</p>
            </div>
          </div>
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  .contact-page {
    padding-bottom: var(--space-2xl);
  }

  .page-header {
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .container-narrow {
    max-width: var(--container-narrow);
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .category-label {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-md);
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--black);
    margin-bottom: var(--space-lg);
  }

  .page-description {
    font-size: 1.1rem;
    color: var(--gray-600);
    max-width: 550px;
    margin: 0;
  }

  .section-divider {
    border: none;
    border-top: var(--border-dotted);
    max-width: var(--container-narrow);
    margin: 0 auto var(--space-xl);
    padding: 0 var(--space-xl);
  }

  .email-card {
    background-color: var(--gray-50);
    border-left: 3px solid var(--accent);
    padding: var(--space-xl);
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  .email-label {
    font-size: 0.8rem;
    color: var(--gray-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .email-link {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--accent);
    text-decoration: none;
    display: block;
    margin-bottom: var(--space-sm);
  }

  .email-link:hover {
    color: var(--accent-dark);
    text-decoration: underline;
  }

  .email-note {
    font-size: 0.85rem;
    color: var(--gray-500);
    margin: 0;
  }

  .note-card {
    margin-top: var(--space-2xl);
    padding: var(--space-lg);
    background-color: #f0fdf4;
    border-left: 3px solid var(--accent);
  }

  .note-card p {
    font-style: italic;
    color: var(--gray-700);
    margin: 0;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .page-header {
      padding: var(--space-2xl) 0 var(--space-lg);
    }

    .container-narrow {
      padding: 0 var(--space-md);
    }

    .email-link {
      font-size: 1.35rem;
    }
  }
</style>
