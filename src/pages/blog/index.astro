---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTitle = `All Reviews — ${SITE_TITLE}`;
const pageDescription = 'Browse all software reviews, comparisons, and guides on Munex.';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
  </head>
  <body>
    <Header />
    
    <main>
      <section class="blog-header">
        <div class="container">
          <h1 class="page-title">All Reviews</h1>
          <p class="page-description">
            In-depth software reviews and comparisons. No sponsored content, no affiliate bias—just honest assessments.
          </p>
        </div>
      </section>

      <hr class="section-divider" />

      <section class="blog-list">
        <div class="container">
          <div class="posts-grid">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .blog-header {
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    color: var(--black);
    margin-bottom: var(--space-md);
  }

  .page-description {
    font-size: 1.1rem;
    color: var(--gray-600);
    max-width: 600px;
    margin: 0;
  }

  .section-divider {
    border: none;
    border-top: var(--border-dotted);
    max-width: var(--container-max);
    margin: 0 auto var(--space-xl);
    padding: 0 var(--space-xl);
  }

  .blog-list {
    padding-bottom: var(--space-2xl);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .container {
      padding: 0 var(--space-md);
    }

    .blog-header {
      padding: var(--space-2xl) 0 var(--space-lg);
    }

    .posts-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
