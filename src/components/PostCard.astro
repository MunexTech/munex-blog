---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate } = post.data;

// Extract category from title or use default
function getCategory(title: string): string {
  const lowerTitle = title.toLowerCase();
  if (lowerTitle.includes('ai') || lowerTitle.includes('chatgpt') || lowerTitle.includes('claude')) return 'AI Tools';
  if (lowerTitle.includes('crm') || lowerTitle.includes('project management')) return 'Business';
  if (lowerTitle.includes('website') || lowerTitle.includes('builder')) return 'Web Tools';
  if (lowerTitle.includes('video') || lowerTitle.includes('conferencing')) return 'Communication';
  if (lowerTitle.includes('productivity') || lowerTitle.includes('remote')) return 'Productivity';
  if (lowerTitle.includes('vs')) return 'Comparison';
  return 'Software';
}

const category = getCategory(title);
---

<article class:list={['post-card', { featured }]}>
  <a href={`/blog/${post.id}/`} class="post-card-link">
    <div class="post-card-content">
      <span class="category-label">{category}</span>
      <h3 class="post-title">{title}</h3>
      <p class="post-description">{description}</p>
      <div class="post-meta">
        <FormattedDate date={pubDate} />
        <span class="read-more">Read more →</span>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    border-left: 3px solid var(--accent);
    background-color: var(--white);
    transition: all 0.2s ease;
  }

  .post-card:hover {
    background-color: var(--gray-50);
  }

  .post-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-card-content {
    padding: var(--space-lg) var(--space-xl);
  }

  .category-label {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--black);
    margin-bottom: var(--space-sm);
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .post-card:hover .post-title {
    color: var(--accent-dark);
  }

  .post-description {
    font-size: 0.95rem;
    color: var(--gray-600);
    margin-bottom: var(--space-md);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: var(--gray-500);
  }

  .read-more {
    color: var(--accent);
    font-weight: 500;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .post-card:hover .read-more {
    opacity: 1;
  }

  /* Featured variant */
  .featured {
    border-left-width: 4px;
  }

  .featured .post-card-content {
    padding: var(--space-xl) var(--space-2xl);
  }

  .featured .post-title {
    font-size: 1.75rem;
  }

  .featured .post-description {
    -webkit-line-clamp: 3;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .post-card-content {
      padding: var(--space-md) var(--space-lg);
    }

    .post-title {
      font-size: 1.15rem;
    }

    .featured .post-card-content {
      padding: var(--space-lg);
    }

    .featured .post-title {
      font-size: 1.35rem;
    }

    .read-more {
      opacity: 1;
    }
  }
</style>
