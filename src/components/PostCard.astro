---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate } = post.data;

// Extract category from title or use default
function getCategory(title: string): string {
  const lowerTitle = title.toLowerCase();
  if (lowerTitle.includes('ai') || lowerTitle.includes('chatgpt') || lowerTitle.includes('claude')) return 'AI Tools';
  if (lowerTitle.includes('crm') || lowerTitle.includes('project management')) return 'Business';
  if (lowerTitle.includes('website') || lowerTitle.includes('builder')) return 'Web Tools';
  if (lowerTitle.includes('video') || lowerTitle.includes('conferencing')) return 'Communication';
  if (lowerTitle.includes('productivity') || lowerTitle.includes('remote')) return 'Productivity';
  if (lowerTitle.includes('vs')) return 'Comparison';
  return 'Software';
}

const category = getCategory(title);
---

<article class:list={['post-card', { featured }]}>
  <a href={`/blog/${post.id}/`} class="post-card-link">
    <div class="post-card-content">
      <span class="tag">{category}</span>
      <h3 class="post-title">{title}</h3>
      <p class="post-description">{description}</p>
      <div class="post-meta">
        <FormattedDate date={pubDate} />
        <span class="read-more">Read →</span>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    border-left: 3px solid var(--primary);
    background-color: var(--bg);
    transition: all var(--transition-normal);
    border-radius: 0 8px 8px 0;
  }

  .post-card:hover {
    background-color: var(--bg-surface);
    transform: translateX(4px);
  }

  .post-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-card-content {
    padding: var(--space-lg) var(--space-xl);
  }

  .tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--primary);
    background-color: rgba(13, 148, 136, 0.1);
    padding: 0.2em 0.6em;
    border-radius: 4px;
    margin-bottom: var(--space-sm);
  }

  .post-title {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: var(--space-sm);
    line-height: 1.4;
    transition: color var(--transition-fast);
  }

  .post-card:hover .post-title {
    color: var(--primary);
  }

  .post-description {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .read-more {
    color: var(--primary);
    font-weight: 500;
    opacity: 0;
    transform: translateX(-8px);
    transition: all var(--transition-fast);
  }

  .post-card:hover .read-more {
    opacity: 1;
    transform: translateX(0);
  }

  /* Featured variant */
  .featured {
    border-left-width: 4px;
    background: linear-gradient(135deg, rgba(13, 148, 136, 0.03), rgba(245, 158, 11, 0.03));
  }

  .featured .post-card-content {
    padding: var(--space-xl) var(--space-2xl);
  }

  .featured .post-title {
    font-size: 1.5rem;
  }

  .featured .post-description {
    -webkit-line-clamp: 3;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .post-card-content {
      padding: var(--space-md) var(--space-lg);
    }

    .post-title {
      font-size: 1.1rem;
    }

    .featured .post-card-content {
      padding: var(--space-lg);
    }

    .featured .post-title {
      font-size: 1.25rem;
    }

    .read-more {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
