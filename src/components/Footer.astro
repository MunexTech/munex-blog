---
const year = new Date().getFullYear();

const footerLinks = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---

<footer class="footer">
  <div class="footer-inner">
    <hr class="footer-divider" />
    
    <div class="footer-content">
      <div class="footer-brand">
        <a href="/" class="footer-logo">Munex</a>
        <p class="footer-tagline">Honest software reviews. No fluff.</p>
      </div>
      
      <nav class="footer-nav">
        {footerLinks.map((link) => (
          <a href={link.href} class="footer-link">{link.label}</a>
        ))}
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="copyright">© {year} Munex. All rights reserved.</p>
      <a href="mailto:support@munex.in" class="contact-link">support@munex.in</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-4xl);
    padding-bottom: var(--space-2xl);
  }

  .footer-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .footer-divider {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--border), transparent);
    margin-bottom: var(--space-2xl);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2xl);
    margin-bottom: var(--space-xl);
  }

  .footer-brand {
    flex: 1;
  }

  .footer-logo {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-xs);
  }

  .footer-logo:hover {
    color: var(--primary);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  .footer-nav {
    display: flex;
    gap: var(--space-lg);
  }

  .footer-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--primary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .copyright {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }

  .contact-link {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .contact-link:hover {
    color: var(--primary);
  }

  @media (max-width: 640px) {
    .footer-inner {
      padding: 0 var(--space-md);
    }

    .footer-content {
      flex-direction: column;
      gap: var(--space-lg);
    }

    .footer-nav {
      flex-wrap: wrap;
      gap: var(--space-md);
    }

    .footer-bottom {
      flex-direction: column;
      gap: var(--space-sm);
      text-align: center;
    }
  }
</style>
